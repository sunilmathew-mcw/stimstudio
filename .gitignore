# Operating System files
.DS_Store
.AppleDouble
.LSOverride
._*
Thumbs.db
Desktop.ini

# Python runtime & build artifacts
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
*.egg
build/
dist/
wheels/
*.so
.pytest_cache/
.coverage
htmlcov/
